<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Устаревший агент: остаётся в бандле только ради снятия старой
	     регистрации (см. DictationBridge.migrateLoginAgent). Не запускается. -->
	<!-- Отдельный launch-агент, а не SMAppService.mainApp: агент запускает
	     тот же исполняемый файл, но добавляет флаг --login-item в argv.
	     Это даёт увидеть «нас подняла система» через обычный CommandLine,
	     без чтения Apple Event, которое в прошлый раз срывало запуск. -->
	<key>Label</key>
	<string>app.yuko.tsukiko.login-item</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/tsukiko</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/tsukiko</string>
		<string>--login-item</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
